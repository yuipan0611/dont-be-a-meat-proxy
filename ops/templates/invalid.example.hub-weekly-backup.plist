<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>invalid.example.hub-weekly-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/ops/pull-weekly-backup.sh</string>
        <string>--host</string><string>192.0.2.10</string>
        <string>--user</string><string>root</string>
        <string>--port</string><string>22</string>
        <string>--remote-dir</string><string>/var/lib/neighbor-hub/backups</string>
        <string>--age-recipient-file</string><string>__HOME__/.config/hub-backup/recipient.txt</string>
        <string>--local-dir</string><string>__HOME__/Backups/neighbor-hub</string>
        <string>--keep-weeks</string><string>12</string>
        <string>--quiet</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Run every Sunday at 04:00 AM -->
        <key>Weekday</key>
        <integer>7</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hub-weekly-backup.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hub-weekly-backup.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
