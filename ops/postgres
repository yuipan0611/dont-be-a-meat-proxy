#!/usr/bin/env bash
# Operator-only access to the standalone L-01 stack. No password in argv or output.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PG_COMPOSE=(docker compose -p "${HUB_PG_PROJECT:-neighbor-hub-db}" -f "$REPO_ROOT/deploy/postgres/compose.yaml")
case "${1:-}" in
  migrate)
    "${PG_COMPOSE[@]}" exec -T db bash /opt/hub-postgres/migrate.sh
    ;;
  psql)
    shift
    "${PG_COMPOSE[@]}" exec -T db psql -X -U postgres -d hub -v ON_ERROR_STOP=1 "$@"
    ;;
  hindsight-init)
    # L-02: create database hindsight + login hindsight_app. Password file is read here by the root
    # operator and passed by NAME (-e VAR), so it never appears in argv or docker inspect.
    PRIVATE_DIR="${HUB_PRIVATE_DIR:-/var/lib/neighbor-hub/private}"
    HINDSIGHT_DB_PASSWORD="$(cat "$PRIVATE_DIR/hindsight-db.password")"
    export HINDSIGHT_DB_PASSWORD
    "${PG_COMPOSE[@]}" exec -T -e HINDSIGHT_DB_PASSWORD db psql -X -U postgres -d postgres -v ON_ERROR_STOP=1 -f /opt/hub-postgres/hindsight.sql
    ;;
  dump)
    "${PG_COMPOSE[@]}" exec -T db pg_dump -U postgres -d "${2:-hub}" --format=custom --no-owner
    ;;
  verify-dump)
    "${PG_COMPOSE[@]}" exec -T db pg_restore --list
    ;;
  *) echo 'Usage: ops/postgres migrate | hindsight-init | psql [psql options] | dump [hub|hindsight] | verify-dump' >&2; exit 2 ;;
esac
