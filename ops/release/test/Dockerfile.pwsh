FROM node:22-bullseye AS node-runtime
FROM mcr.microsoft.com/powershell:7.4-ubuntu-22.04
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git python3 && apt-get clean
ENV P7_TEST_POWERSHELL=pwsh
WORKDIR /src
CMD ["python3", "ops/release/test/install_test.py", "-v"]
