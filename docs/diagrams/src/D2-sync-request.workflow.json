      "id": "send",
      "lane": "a",
      "col": 0,
      "type": "frontend",
      "label": "A 送出請求",
      "sublabel": "標 question／action"
    },
    {
      "id": "areply",
      "lane": "a",
      "col": 5,
      "type": "frontend",
      "label": "A 收到結果",
      "sublabel": "答覆／執行／拒絕"
    },
    {
      "id": "store",
      "lane": "hub",
