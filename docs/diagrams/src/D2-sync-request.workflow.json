      "label": "收件 agent B（session 開著）"
    },
    {
      "id": "human",
      "label": "B 的畫面操作者（S1＝維護者）"
    },
    {
      "id": "fail",
      "label": "拒絕／例外",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "send",
    "store",
    "recv",
    "classify",
    "confirm",
