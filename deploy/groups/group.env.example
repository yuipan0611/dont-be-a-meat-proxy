# Non-secret input: copy OUTSIDE Git to /etc/neighbor-hub/groups/<group>.env.
# Every group needs a distinct Compose project, private dirs, spool, ports and hostname.
HUB_GROUP_ID=grp-test
COMPOSE_PROJECT_NAME=neighbor-hub-grp-test
HUB_PRIVATE_DIR=/var/lib/neighbor-hub/groups/grp-test/private
HUB_VALIDATOR_POLICY_DIR=/var/lib/neighbor-hub/groups/grp-test/private/validator
HUB_MAIL_PORT=8765
HUB_MEMORY_PROJECT=neighbor-hub-memory-grp-test
HUB_MEMORY_PRIVATE_DIR=/var/lib/neighbor-hub/groups/grp-test/private/memory
HUB_BANKPROXY_STATE_DIR=/var/lib/neighbor-hub/groups/grp-test/bank-proxy
HUB_BANKPROXY_PORT=8780
HUB_PG_PROJECT=neighbor-hub-db
HUB_BOT_SECRET_DIR=/var/lib/neighbor-hub/groups/grp-test/private/bot
HUB_TOKEN_SPOOL_DIR=/var/lib/neighbor-hub/groups/grp-test/token-spool
HUB_PUBLIC_URL=https://grp-test.hub.example.invalid
HUB_OPS_UID=10001
HUB_OPS_GID=10001
# Set Discord IDs and HUB_BOT_UID/GID before adding the bot override (L03 runbook).
